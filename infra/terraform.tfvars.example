# Copy to terraform.tfvars (git-ignored). See DESIGN.md for what each choice means.

aws_region   = "us-east-1"
project_name = "securelitellm"
environment  = "dev"

github_repo = "uchenna-j-edeh/securelitellm"

# ACM certificate issued in aws_region for the hostname that points to the ALB.
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
proxy_domain_name   = "securelitellm.example.com"

# Required, no default: who may reach the load balancer. Use your campus or
# home network ranges. ["0.0.0.0/0"] opens it to everyone (agent keys are
# still required for every request).
allowed_cidrs = ["203.0.113.0/24"]

# Optional
# alarm_email   = "you@example.com"
# desired_count = 2   # a second task in the same AZ removes the restart gap
