# Copy to terraform.tfvars (never commit terraform.tfvars — it may contain
# sensitive overrides). Adjust values for your deployment target.

aws_region   = "us-east-1"
project_name = "securelitellm"
environment  = "dev"

github_repo = "uchenna-j-edeh/securelitellm"

# ACM certificate issued in aws_region for the hostname that points to the ALB.
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
proxy_domain_name   = "securelitellm.example.com"

task_cpu    = 2048 # litellm + Ollama sidecar for sensitive data (#181)
task_memory = 4096

# Secure defaults. Set router_enforce to "false" only for audit-only experiments.
router_mode    = "session"
router_level   = "L3"
router_enforce = "true"

classifier_backend    = "promptguard"
promptguard_threshold = "0.5"
