# For the basic mock stack, copy this file to .env in the repository root.
# For the live team demo, run `make demo-setup`; it safely creates deploy/.env.
# Never commit or share either private file.

# LiteLLM proxy auth — generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=replace-with-a-long-random-local-secret

# LLM provider API key — use an individually issued key, never a shared team key.
# Free:  Groq        → https://console.groq.com
# Paid:  Anthropic   → https://console.anthropic.com
#        Google      → https://aistudio.google.com
#        OpenAI      → https://platform.openai.com
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# M3 classifier settings
# CLASSIFIER_BACKEND=promptguard   # promptguard | llmguard | none (default)
# PROMPTGUARD_THRESHOLD=0.5        # injection score threshold (0-1)

# Secure routing defaults. Set ROUTER_ENFORCE=false only for an explicit
# audit-only experiment; false records decisions but does not enforce them.
ROUTER_MODE=session
ROUTER_LEVEL=L3
ROUTER_ENFORCE=true

# Demo agent and tool service
# llama maps to groq/openai/gpt-oss-120b in deploy/litellm_config.yaml.
DEMO_MODEL=llama
DEMO_TOOL_SERVER_URL=http://localhost:8002

# Email is local-only by default. Set smtp explicitly for real delivery.
DEMO_EMAIL_MODE=log
DEMO_RECIPIENT=demo-recipient@example.test
DEMO_EMAIL_ALLOWLIST=demo-recipient@example.test
DEMO_EMAIL_SUBJECT_PREFIX='[SecureLiteLLM DEMO]'

# Generic SMTP settings. For Google Workspace/Gmail, SMTP_HOST is normally
# smtp.gmail.com and SMTP_PORT is 587. Use an app password or approved relay;
# never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
