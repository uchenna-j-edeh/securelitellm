# Copy this file to deploy/.env and fill in real values. Never commit .env.

# LiteLLM proxy auth — generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=replace-with-a-long-random-local-secret

# LLM provider API key — only the one you're using needs a value.
# Free:  Groq        → https://console.groq.com
# Paid:  Anthropic   → https://console.anthropic.com
#        Google      → https://aistudio.google.com
#        OpenAI      → https://platform.openai.com
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
