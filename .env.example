# Copy this file to deploy/.env and fill in real values. Never commit .env.

# LiteLLM proxy auth — generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=replace-with-a-long-random-local-secret

# LLM provider keys — add whichever you have; unused ones can stay blank.
# model alias → provider / free tier availability
#   groq   → Groq         free  https://console.groq.com
#   gemini → Google       free  https://aistudio.google.com
#   claude → Anthropic    paid  https://console.anthropic.com
#   gpt    → OpenAI       paid  https://platform.openai.com
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
